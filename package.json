{
  "name": "mochi-meadow",
  "private": true,
  "version": "1.0.0",
  "description": "Mochi Meadow: a cozy habit tracker where your habits grow plants and power capsule machines full of cats, cows and friends.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "shots": "node scripts/screenshots.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.4",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7",
    "workbox-window": "^7.4.1"
  }
}
