{
  "name": "little-by-little",
  "private": true,
  "version": "1.0.0",
  "description": "Little by Little: a habit tracker where your habits grow houseplants, and the plants become a home for small real animals.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "vite build",
    "build:single": "vite build --mode single && node -e \"require('node:fs').renameSync('dist-single/index.html','dist-single/catkin.html')\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:preview": "node scripts/e2e-preview.mjs",
    "size": "node scripts/size-budget.mjs",
    "shots": "node scripts/shoot.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "manifest-assets": "node scripts/manifest-assets.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run size && npm run build:single && npm run e2e:preview",
    "perf:scale": "node tests/perf/run.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/castoro": "^5.3.0",
    "@playwright/test": "1.57.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "4.1.11",
    "workbox-window": "^7.4.1"
  }
}
