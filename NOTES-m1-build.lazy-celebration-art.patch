diff --git a/tests/unit/fx/celebrationArtLoader.test.tsx b/tests/unit/fx/celebrationArtLoader.test.tsx
new file mode 100644
index 0000000..5c37eb7
--- /dev/null
+++ b/tests/unit/fx/celebrationArtLoader.test.tsx
@@ -0,0 +1,31 @@
+// @vitest-environment jsdom
+import { afterEach, describe, expect, it } from 'vitest';
+import { render } from 'preact';
+import { act } from 'preact/test-utils';
+import { celebrationArtReady, celebrationArtWithin, LazyCelebrationArt, loadCelebrationArt } from '@/fx/celebrationArtLoader';
+
+const host = () => document.getElementById('app')!;
+
+afterEach(() => {
+  act(() => render(null, host()));
+});
+document.body.innerHTML = '<div id="app"></div>';
+
+describe('celebration art, loaded on demand', () => {
+  it('holds the art’s square until the chunk is in, then draws it in place', async () => {
+    expect(celebrationArtReady()).toBe(false);
+    act(() => render(<LazyCelebrationArt art={{ type: 'currency', kind: 'coins' }} size={40} />, host()));
+    const box = host().querySelector('span[aria-hidden="true"]') as HTMLElement | null;
+    expect(box?.style.width).toBe('40px');
+    expect(host().querySelector('svg')).toBeNull();
+    await act(() => loadCelebrationArt().then(() => undefined));
+    expect(celebrationArtReady()).toBe(true);
+    expect(host().querySelector('svg')).not.toBeNull();
+  });
+
+  it('loads the module once and caches it', async () => {
+    const [a, b] = await Promise.all([loadCelebrationArt(), loadCelebrationArt()]);
+    expect(a).toBe(b);
+    await expect(celebrationArtWithin(0)).resolves.toBeUndefined();
+  });
+});
