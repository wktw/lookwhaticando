diff --git a/src/fx/celebrationArtLoader.tsx b/src/fx/celebrationArtLoader.tsx
new file mode 100644
index 0000000..1eda450
--- /dev/null
+++ b/src/fx/celebrationArtLoader.tsx
@@ -0,0 +1,76 @@
+/**
+ * CelebrationArt, loaded on demand. The art pulls in every pet, plant, item and badge drawing
+ * (with the pet crescents and the decor shade table), so it lives in its own chunk instead of the
+ * entry: the host warms it when the browser is idle after first paint, and waits for it (briefly)
+ * before its first note or banner.
+ */
+import type { ComponentProps } from 'preact';
+import { useEffect, useState } from 'preact/hooks';
+
+type ArtModule = typeof import('./CelebrationArt');
+export type CelebrationArtProps = ComponentProps<ArtModule['CelebrationArt']>;
+
+let loaded: ArtModule | null = null;
+let pending: Promise<ArtModule> | null = null;
+
+/** The art module, fetched once and cached; a failed fetch can be retried. */
+export function loadCelebrationArt(): Promise<ArtModule> {
+  if (loaded) return Promise.resolve(loaded);
+  pending ??= import('./CelebrationArt').then(
+    (m) => (loaded = m),
+    (err: unknown) => {
+      pending = null;
+      throw err;
+    },
+  );
+  return pending;
+}
+
+/** True once the art is in memory (a note or banner can then draw it on its first frame). */
+export const celebrationArtReady = (): boolean => loaded !== null;
+
+/** Resolves when the art is in, or after `capMs`, whichever is first. Never rejects. */
+export function celebrationArtWithin(capMs: number): Promise<void> {
+  if (loaded) return Promise.resolve();
+  return new Promise((resolve) => {
+    const t = setTimeout(resolve, capMs);
+    loadCelebrationArt().then(
+      () => (clearTimeout(t), resolve()),
+      () => (clearTimeout(t), resolve()),
+    );
+  });
+}
+
+/** Warm the chunk once the browser is idle, so the first celebration has nothing to wait for. */
+export function preloadCelebrationArtWhenIdle(): () => void {
+  if (loaded || typeof window === 'undefined') return () => undefined;
+  const warm = () => void loadCelebrationArt().catch(() => undefined);
+  // Safari has no requestIdleCallback.
+  if (typeof window.requestIdleCallback === 'function') {
+    const id = window.requestIdleCallback(warm, { timeout: 4000 });
+    return () => window.cancelIdleCallback(id);
+  }
+  const id = setTimeout(warm, 1500);
+  return () => clearTimeout(id);
+}
+
+/**
+ * The celebration art, drawn from the cached module. Until the chunk arrives it holds the art's
+ * square (decorative either way: the copy says it all), then draws in place.
+ */
+export function LazyCelebrationArt(props: CelebrationArtProps) {
+  const [mod, setMod] = useState<ArtModule | null>(loaded);
+  useEffect(() => {
+    if (mod) return;
+    let live = true;
+    loadCelebrationArt().then(
+      (m) => live && setMod(() => m),
+      () => undefined,
+    );
+    return () => {
+      live = false;
+    };
+  }, []);
+  if (mod) return <mod.CelebrationArt {...props} />;
+  return <span aria-hidden="true" style={{ display: 'inline-block', width: `${props.size}px`, height: `${props.size}px` }} />;
+}
